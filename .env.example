# Copie para .env e ajuste os valores locais.
# Com Docker Compose deste repo: host `database`, porta 3306.
# Local sem Docker: use 127.0.0.1:3307 (porta publicada no compose.override).

APP_ENV=dev
APP_SECRET=change-me-in-production
DEFAULT_URI=http://localhost:8081

STORAGE_ROOT=/var/maylove/storage
STORAGE_PUBLIC_URL=http://localhost:8081
SERVICE_TOKEN_SECRET=change-me-shared-secret
UPLOAD_MAX_SIZE_MB=50

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://maylove:secret@database:3306/maylove_storages?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
